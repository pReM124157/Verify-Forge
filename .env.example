# Copy to .env (git-ignored) and fill in. NEVER put a real key in this file.

# Official Anthropic API key, used only with --provider api
ANTHROPIC_API_KEY=

# Provider: api (Anthropic API) or cli (Claude Code login). Default: cli
# VERIFYFORGE_PROVIDER=api

# Model routing (any model id your key can call; run `./vf health --provider api` to test one).
# Judge model: architect, requirement auditor, hidden verifier, triage, replacement-test authors
# VERIFYFORGE_JUDGE_MODEL=
# Builder model: builder and repair
# VERIFYFORGE_BUILDER_MODEL=
# One model for every role (unless the two above are set)
# VERIFYFORGE_DEFAULT_MODEL=

# Per-call timeout in seconds (default 300) and max output tokens (default 8000)
# VERIFYFORGE_MODEL_TIMEOUT_SECONDS=300
# VERIFYFORGE_MAX_OUTPUT_TOKENS=8000
